{
  "name": "mangahere-paperback",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "license": "UNLICENSED",
  "repositoryName": "indigoxred MangaHere",
  "repositoryDescription": "Private-source MangaHere extension repository for Paperback 0.9",
  "scripts": {
    "tsc": "tsc",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --fix",
    "lint:check": "oxlint --type-aware --deny-warnings",
    "conformance": "pnpm run tsc && pnpm run lint:check && pnpm run format:check",
    "test": "tsc --project tsconfig.test.json && node --test \".test-dist/tests/node/**/*.test.js\"",
    "test:paperback": "node -e \"require('node:fs').mkdirSync('bundles',{recursive:true})\" && paperback-cli test --noConsole --output ./bundles/tests.json",
    "bundle": "paperback-cli bundle",
    "serve": "paperback-cli serve",
    "dev": "paperback-cli serve --watch"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "cheerio": "1.2.0"
  },
  "devDependencies": {
    "@paperback/toolchain": "1.0.0-alpha.92",
    "@paperback/types": "1.0.0-alpha.92",
    "@types/chai": "5.2.3",
    "@types/node": "26.4.0",
    "chai": "6.2.1",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  }
}
